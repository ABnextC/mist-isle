  "quests": [
    {
      "id": "q1_ashore", "chapter": "ch1", "kind": "main", "name": "뭍에 오르다",
      "summary": "난파선에서 겨우 살아 나왔다. 언덕 위 등대에 사람이 산다고 한다.",
      "intro": ["난파선에서 겨우 뭍에 올랐다.", "언덕 위 등대에 불이 켜져 있다. 사람이 사는 모양이다."],
      "steps": [
        { "type": "talk", "npc": "haerim", "text": "등대지기 해림 찾아가기",
          "say": [
            "정신이 드나? 바다가 자네를 뱉어 냈구먼.",
            "이 안개를 뚫고 살아 온 사람은 오랜만일세. 여긴 안개섬이야. 지도에 없는 섬이지.",
            "자네 배 뒤로 검은 돛이 따라붙는 걸 봤네. 요즘은 밤마다 그 돛이 섬을 맴돌아.",
            "빈손으로는 해안도 위험해. 이 몽둥이라도 쥐고 다니게."
          ],
          "reply": "고맙습니다" }
      ],
      "reward": { "silver": 20, "items": [{ "item": "wpn_club", "score": 42 }] },
      "next": "q2_chest"
    },
    {
      "id": "q2_chest", "chapter": "ch1", "kind": "main", "name": "떠밀려 온 궤짝",
      "summary": "난파선 짐이 해안에 떠밀려 왔다. 게들을 쫓아내고 궤짝을 찾아보자.",
      "intro": [
        "자네 배 짐이 난파선 뒤편 모래밭에 떠밀려 왔다더군.",
        "그런데 게들이 해안을 차지했어. 몇 마리 혼내 주고 궤짝을 찾아보게. 몽둥이는 가방(I)에서 끼면 되네."
      ],
      "steps": [
        { "type": "kill", "mobs": ["crab"], "count": 3, "text": "해안 게 쓰러뜨리기" },
